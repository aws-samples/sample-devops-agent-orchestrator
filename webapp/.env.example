# ---------------------------------------------------------------------------
# DevOps Observatory Web App — sample environment / config
# ---------------------------------------------------------------------------
# Copy to `.env` for local dev, or set these as environment variables in the
# Amplify hosting / pipeline environment. These values map to the hub backend
# defined in the repo-root `config.env` (the source of truth).
#
# SECURITY: Do NOT put AWS credentials or secrets in this file or in `.env`.
# The browser never holds AWS credentials — the SPA only talks to the API
# layer, and Lambda handlers use their IAM roles. These are non-secret resource
# identifiers used to wire the backend handlers (added in later tasks).
# ---------------------------------------------------------------------------

# AWS region where the hub backend and this app are deployed.
# (config.env: REGION)
HUB_REGION=us-east-1

# Hub AWS account id that owns the S3 bucket, Neptune graph, and KB.
# (config.env: HUB_ACCOUNT_ID)
HUB_ACCOUNT_ID=123456789012

# S3 hub bucket holding raw/_manifest.json, hub/business_context.json, kb/ docs.
# (config.env: HUB_BUCKET)
HUB_BUCKET=devops-agent-hub-123456789012-us-east-1

# Neptune Analytics graph name and endpoint used by the /graph handler (Task 8).
# (config.env: NEPTUNE_GRAPH_NAME)
NEPTUNE_GRAPH_NAME=devops-agent-topology
NEPTUNE_GRAPH_ENDPOINT=g-0123456789.us-east-1.neptune-graph.amazonaws.com

# Bedrock managed knowledge base used by the /chat handler (Task 9).
# (config.env: KB_NAME) — the resolved KB id (KB_ID) is injected at deploy time;
# the SPA never sees these. KB_CHAT_MODEL_ARN is the chat model / inference
# profile that synthesizes the answer. (config.env: KB_CHAT_MODEL_ARN)
KB_NAME=devops-agent-kb
KB_ID=PLACEHOLDER_KB_ID
KB_CHAT_MODEL_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ---------------------------------------------------------------------------
# Deployment / hosting wiring (Task 19)
# ---------------------------------------------------------------------------
# These are read by the Amplify Gen 2 backend at deploy time (`amplify/backend.ts`
# via process.env) and by the CI/CD build. Set them as Amplify Hosting
# environment variables for the branch, NOT in committed source. See
# OPERATIONS.md for the full deploy runbook.

# Browser origin(s) allowed by CORS on the HTTP API and the /chat Function URL.
# Set to the deployed SPA origin once known (comma-separate for multiple, e.g. a
# custom domain plus the *.amplifyapp.com URL). Defaults to `*` when unset so a
# sandbox/preview deploy works; tighten in production.
# e.g. APP_ORIGIN=https://main.d123abc.amplifyapp.com,https://observatory.example.com
APP_ORIGIN=*

# Optional: management-account role ARN the refresh pipeline assumes to list
# AWS Organizations accounts (config.env: MGMT_ACCOUNT_ID). Leave unset to use
# the Fargate task role itself for org listing.
# e.g. MGMT_ROLE_ARN=arn:aws:iam::210987654321:role/DevOpsAgentOrgListRole
MGMT_ROLE_ARN=

# CI/CD pipeline identifiers, provided automatically by Amplify Hosting during a
# branch build and consumed by `npm run deploy`
# (`ampx pipeline-deploy --branch $AWS_BRANCH --app-id $AWS_APP_ID`). Only set
# these by hand when running a pipeline deploy outside Amplify Hosting.
# AWS_BRANCH=main
# AWS_APP_ID=d123abc456def

# ---------------------------------------------------------------------------
# Frontend (Vite) local-dev overrides — OPTIONAL
# ---------------------------------------------------------------------------
# The SPA normally reads the API base URL and chat stream URL from the
# git-ignored `amplify_outputs.json` (written by `ampx sandbox` / pipeline
# deploy). These `VITE_`-prefixed vars let local dev point at an already-deployed
# API/Function URL without a sandbox. They are compiled into the browser bundle,
# so they MUST remain non-secret URLs only — never put credentials here.
# VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com
# VITE_CHAT_STREAM_URL=https://abcxyz.lambda-url.us-east-1.on.aws/
