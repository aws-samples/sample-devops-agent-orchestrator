# ---------------------------------------------------------------------------
# Shared configuration for the DevOps Agent topology/investigation hub
# ---------------------------------------------------------------------------
# Copy this file to `config.env` and fill in your own values. `config.env` is
# gitignored and MUST NOT be committed — it holds account-specific identifiers.
#
# All values below are non-secret placeholders. Replace them with your own.
# ---------------------------------------------------------------------------

# Management (org) account – holds AWS Organizations + deploys the StackSet.
MGMT_ACCOUNT_ID=210987654321
MGMT_PROFILE=your-mgmt-profile

# Hub account – receives all collected data (S3) and hosts Neptune Analytics.
HUB_ACCOUNT_ID=123456789012
HUB_PROFILE=your-hub-profile

# Region where AWS DevOps Agent + all resources live.
REGION=us-east-1

# Cross-account role created in EVERY linked account. The hub assumes it.
COLLECTOR_ROLE_NAME=DevOpsAgentCollectorRole
# ExternalId hardens the AssumeRole trust (defense against confused deputy).
# Use a value unique to your deployment (e.g. include your hub account id).
EXTERNAL_ID=devops-agent-hub-123456789012

# S3 bucket (in hub account) that stores raw data + generated graph load files.
HUB_BUCKET=devops-agent-hub-123456789012-us-east-1

# Neptune Analytics
NEPTUNE_GRAPH_NAME=devops-agent-topology
# Role Neptune assumes to read the graph load files from S3 (in hub account).
NEPTUNE_LOAD_ROLE_NAME=DevOpsAgentNeptuneLoadRole
# Expose the graph endpoint to the public internet? Default false (recommended):
# the graph is reachable only from inside the VPC, so the network stays a second
# line of defence alongside IAM/SigV4 auth. Set true ONLY for development, and
# note the trade-off: with false, openCypher calls (step 5's sample query and
# 06_query_examples.py) do not work from a laptop - run them from inside the VPC.
NEPTUNE_PUBLIC_CONNECTIVITY=false

# StackSet name used to fan the collector role out across the org.
STACKSET_NAME=DevOpsAgentCollectorRole

# Set true to let the collector role also create a starter agent space in
# accounts that have none (used by ensure_agent_spaces.py). Keep false for a
# strictly read-only collector; flip to true only while bootstrapping.
ALLOW_AGENT_SPACE_CREATION=false

# --- Bedrock Managed Knowledge Base (hub account) ---
KB_NAME=devops-agent-kb
KB_ROLE_NAME=DevOpsAgentKnowledgeBaseRole
# Embedding model (access-verified in hub, 1024 dims). Bedrock manages the store.
KB_EMBED_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0
# Text model used by the chat app (RetrieveAndGenerate). Cross-region inference profile.
KB_CHAT_MODEL_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# S3 prefix (in HUB_BUCKET) holding the human-readable docs the KB ingests.
KB_DOCS_PREFIX=kb/
